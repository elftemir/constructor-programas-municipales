{
  "name": "constructor-programas-municipales",
  "version": "3.8.5",
  "description": "Constructor de Programas Municipales",
  "main": "src/main/main.js",
  "scripts": {
    "start": "electron .",
    "test": "node scripts/run_tests.js",
    "build": "node scripts/setup_verified_cpu.js && node scripts/setup_verified_vulkan.js && node scripts/setup_ocr_runtime.js && electron-builder --win --x64 --publish never",
    "setup:ocr": "node scripts/setup_ocr_runtime.js",
    "preparar-publicacion": "node scripts/entrega_distribucion.js"
  },
  "keywords": [
    "programa-electoral",
    "municipal"
  ],
  "author": {
    "name": "elftemir",
    "email": "elftemir@hotmail.com"
  },
  "license": "GPL-3.0-or-later",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/elftemir/constructor-programas-municipales.git"
  },
  "bugs": {
    "url": "https://github.com/elftemir/constructor-programas-municipales/issues"
  },
  "homepage": "https://github.com/elftemir/constructor-programas-municipales#readme",
  "type": "commonjs",
  "dependencies": {
    "@fontsource/inter": "^5.3.0",
    "@napi-rs/canvas": "1.0.11",
    "@xmldom/xmldom": "^0.9.12",
    "dictionary-ca": "3.0.0",
    "dictionary-es": "4.0.0",
    "electron-updater": "^6.8.9",
    "franc": "6.2.0",
    "hunspell-wasm": "0.3.0",
    "jszip": "^3.10.2",
    "pdf-parse": "^1.1.1",
    "pdfjs-dist": "6.4.299",
    "sql.js": "^1.14.2",
    "tesseract.js": "7.0.0",
    "tesseract.js-core": "7.0.0"
  },
  "devDependencies": {
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3",
    "ignore": "7.0.12",
    "js-yaml": "4.3.2",
    "pdf-lib": "1.17.1"
  },
  "build": {
    "appId": "org.podemos.constructor.municipal",
    "productName": "Constructor de Programas Municipales Podemos",
    "artifactName": "Programa_Electoral_Municipal_Setup_x64_v${version}.${ext}",
    "publish": [
      {
        "provider": "github",
        "owner": "elftemir",
        "repo": "constructor-programas-municipales-updates",
        "protocol": "https",
        "channel": "latest",
        "releaseType": "release",
        "private": false
      }
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "icon": "build/icon.ico",
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": true,
      "allowToChangeInstallationDirectory": false,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "shortcutName": "Constructor de Programas Municipales Podemos",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "installerHeaderIcon": "build/icon.ico",
      "include": "build/installer.nsh"
    },
    "extraFiles": [
      {
        "from": "build/icon.ico",
        "to": "app.ico"
      }
    ],
    "extraResources": [
      {
        "from": "vendor/llama/cpu",
        "to": "vendor/llama/cpu",
        "filter": [
          "llama-server.exe",
          "llama-server-impl.dll",
          "llama-common.dll",
          "llama.dll",
          "mtmd.dll",
          "ggml.dll",
          "ggml-base.dll",
          "ggml-rpc.dll",
          "ggml-cpu-*.dll",
          "libomp.dll",
          "LICENSE-LLVM-OpenMP",
          "manifest.json"
        ]
      },
      {
        "from": "vendor/llama/vulkan",
        "to": "vendor/llama/vulkan",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "resources/ocr-runtime",
        "to": "ocr-runtime"
      }
    ],
    "files": [
      "src/**/*",
      "!src/main/assets/data/catalogo_marco.json",
      "!**/catalogo_*.json",
      "!**/catalogo_validacion.html",
      "!**/extracted_raw.txt",
      "!src/main/assets/data/**/*",
      "src/main/assets/data/municipios_ine.csv",
      "src/main/assets/data/municipios_catalunya.json",
      "src/main/assets/data/catalogo_modelos*.json",
      "src/main/assets/data/catalogo_municipios*.json",
      "!**/*.pdf",
      "!**/*.gguf",
      "!**/*.ggml",
      "!scratch/**",
      "!scripts/**",
      "!**/scripts/**",
      "!**/test*.js",
      "!**/*.map",
      "!test*/**",
      "!content-fixtures/**",
      "!data/models/**",
      "!data/catalogo_marco.json",
      "!data/programa_electoral.sqlite",
      "!data/models/**/*",
      "package.json",
      "!node_modules/tesseract.js/**/*",
      "!node_modules/bmp-js/**/*",
      "!node_modules/idb-keyval/**/*",
      "!node_modules/is-url/**/*",
      "!node_modules/node-fetch/**/*",
      "!node_modules/whatwg-url/**/*",
      "!node_modules/tr46/**/*",
      "!node_modules/webidl-conversions/**/*",
      "!node_modules/opencollective-postinstall/**/*",
      "!node_modules/regenerator-runtime/**/*",
      "!node_modules/tesseract.js-core/**/*",
      "!node_modules/wasm-feature-detect/**/*",
      "!node_modules/zlibjs/**/*",
      "!node_modules/pdfjs-dist/**/*",
      "!node_modules/@napi-rs/canvas/**/*",
      "!node_modules/@napi-rs/canvas-win32-x64-msvc/**/*",
      "!node_modules/hunspell-wasm/src/**/*",
      "!node_modules/hunspell-wasm/docs/**/*",
      "!node_modules/hunspell-wasm/dist/Test.*",
      "!node_modules/hunspell-wasm/tsconfig.json",
      "data/ai_models.json",
      "data/municipios_ine.csv",
      "data/municipios_catalunya.json",
      "!**/*.sqlite",
      "!**/*.db",
      "!**/*.sqlite3"
    ],
    "asar": true,
    "afterPack": "scripts/pack_ocr_runtime.js"
  }
}
