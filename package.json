{
  "name": "constructor-programas-municipales",
  "version": "3.6.1",
  "description": "Constructor de Programas Municipales",
  "main": "src/main/main.js",
  "scripts": {
    "start": "electron .",
    "test": "node scripts/run_tests.js",
    "build": "node scripts/setup_ocr_runtime.js && electron-builder --win --x64 --publish never",
    "setup:ocr": "node scripts/setup_ocr_runtime.js",
    "preparar-publicacion": "node scripts/preparar_publicacion.js"
  },
  "keywords": [
    "programa-electoral",
    "municipal"
  ],
  "author": {
    "name": "elftemir",
    "email": "elftemir@hotmail.com"
  },
  "license": "GPL-3.0-or-later",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/elftemir/constructor-programas-municipales.git"
  },
  "bugs": {
    "url": "https://github.com/elftemir/constructor-programas-municipales/issues"
  },
  "homepage": "https://github.com/elftemir/constructor-programas-municipales#readme",
  "type": "commonjs",
  "dependencies": {
    "@fontsource/inter": "^5.3.0",
    "@napi-rs/canvas": "1.0.11",
    "@xmldom/xmldom": "^0.9.12",
    "electron-updater": "^6.8.9",
    "jszip": "^3.10.2",
    "pdf-parse": "^1.1.1",
    "pdfjs-dist": "6.4.299",
    "sql.js": "^1.14.2",
    "tesseract.js": "7.0.0",
    "tesseract.js-core": "7.0.0"
  },
  "devDependencies": {
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3",
    "ignore": "7.0.12",
    "js-yaml": "4.3.2"
  },
  "build": {
    "appId": "org.podemos.constructor.municipal",
    "productName": "Constructor de Programas Municipales Podemos",
    "artifactName": "Programa_Electoral_Municipal_Setup_x64_v${version}.${ext}",
    "publish": [
      {
        "provider": "github",
        "owner": "elftemir",
        "repo": "constructor-programas-municipales-updates",
        "protocol": "https",
        "channel": "latest",
        "releaseType": "release",
        "private": false
      }
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "icon": "build/icon.ico",
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": true,
      "allowToChangeInstallationDirectory": false,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "shortcutName": "Constructor de Programas Municipales Podemos",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "installerHeaderIcon": "build/icon.ico",
      "include": "build/installer.nsh"
    },
    "extraFiles": [
      {
        "from": "build/icon.ico",
        "to": "app.ico"
      }
    ],
    "extraResources": [
      {
        "from": "resources/ai-runtime",
        "to": "ai-runtime",
        "filter": [
          "llama.cpp/llama-server.exe",
          "llama.cpp/llama-server-impl.dll",
          "llama.cpp/llama-common.dll",
          "llama.cpp/llama.dll",
          "llama.cpp/mtmd.dll",
          "llama.cpp/ggml.dll",
          "llama.cpp/ggml-base.dll",
          "llama.cpp/ggml-rpc.dll",
          "llama.cpp/ggml-cpu-*.dll",
          "llama.cpp/libomp.dll",
          "llama.cpp/LICENSE-LLVM-OpenMP"
        ]
      },
      {
        "from": "resources/ocr-runtime",
        "to": "ocr-runtime"
      }
    ],
    "files": [
      "src/**/*",
      "!data/catalogo_marco.json",
      "!data/programa_electoral.sqlite",
      "!data/models/**/*",
      "package.json",
      "!node_modules/tesseract.js/**/*",
      "!node_modules/bmp-js/**/*",
      "!node_modules/idb-keyval/**/*",
      "!node_modules/is-url/**/*",
      "!node_modules/node-fetch/**/*",
      "!node_modules/whatwg-url/**/*",
      "!node_modules/tr46/**/*",
      "!node_modules/webidl-conversions/**/*",
      "!node_modules/opencollective-postinstall/**/*",
      "!node_modules/regenerator-runtime/**/*",
      "!node_modules/tesseract.js-core/**/*",
      "!node_modules/wasm-feature-detect/**/*",
      "!node_modules/zlibjs/**/*",
      "!node_modules/pdfjs-dist/**/*",
      "!node_modules/@napi-rs/canvas/**/*",
      "!node_modules/@napi-rs/canvas-win32-x64-msvc/**/*",
      "data/ai_models.json",
      "data/municipios_ine.csv",
      "data/municipios_catalunya.json",
      "!**/*.sqlite",
      "!**/*.db",
      "!**/*.sqlite3"
    ],
    "asar": true,
    "afterPack": "scripts/pack_ocr_runtime.js"
  }
}
